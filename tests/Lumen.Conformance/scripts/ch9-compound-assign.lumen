let n := 10;
n += 5;
puts(n);            // expect: 15
n -= 3;
puts(n);            // expect: 12
n *= 2;
puts(n);            // expect: 24
n /= 5;
puts(n);            // expect: 4

// 任一邊是 Float 就走 Float 路徑，跟一般 infix 一樣
let f := 1.5;
f *= 2;
puts(f);            // expect: 3.0

// String 只支援 +=
let s := "lu";
s += "men";
puts(s);            // expect: lumen

// for 的 update clause 與 body 都可以用複合賦值
let sum := 0;
for (let i := 1; i <= 4; i += 1) {
  sum += i;
}
puts(sum);          // expect: 10

// closure 內的 += 改的是被捕捉的 binding，不是複本
let counter := fn() {
  let c := 0;
  fn() { c += 1; return c; }
};
let c := counter();
c();
puts(c());          // expect: 2
