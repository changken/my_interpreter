fn map(arr, f) {
  fn iter(remaining, acc) {
    if (len(remaining) == 0) { acc } else { iter(rest(remaining), push(acc, f(first(remaining)))) }
  }
  iter(arr, [])
}

fn reduce(arr, initial, f) {
  let result := initial;
  for (let i := 0; i < len(arr); i := i + 1) {
    result := f(result, arr[i]);
  }
  result
}

let nums := [1, 2, 3, 4];
puts(map(nums, fn(x) { x * x }));                   // expect: [1, 4, 9, 16]
puts(reduce(nums, 0, fn(acc, x) { acc + x }));      // expect: 10
puts(reduce(map(nums, fn(x) { x * 2 }), 1, fn(acc, x) { acc * x }));  // expect: 384
puts(len("👍"));                                    // expect: 2
